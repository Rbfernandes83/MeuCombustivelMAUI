
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MeuCombustivelMAUI.MainPage"
    BackgroundColor="#F5F7FA"
    Title="Meu Combustível">

    <ScrollView>
        <VerticalStackLayout
            Padding="20,25"
            Spacing="18">

            <!-- Cabeçalho -->
            <Border
                BackgroundColor="#17365D"
                StrokeThickness="0"
                Padding="22"
                StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="MEU COMBUSTÍVEL"
                        FontSize="25"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Economize na hora de abastecer"
                        FontSize="14"
                        TextColor="#DCE8F5"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Dados do veículo -->
            <Border
                BackgroundColor="White"
                Stroke="#E0E6ED"
                StrokeThickness="1"
                Padding="18"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Dados do veículo"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#17365D" />

                    <Label
                        Text="Marca do veículo"
                        TextColor="#344054"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="MarcaEntry"
                        Placeholder="Ex.: Chevrolet"
                        TextColor="#222222"
                        PlaceholderColor="#8792A2"
                        BackgroundColor="#F2F5F9" />

                    <Label
                        Text="Modelo do veículo"
                        TextColor="#344054"
                        FontAttributes="Bold" />

                    <Entry
                        x:Name="ModeloEntry"
                        Placeholder="Ex.: Prisma"
                        TextColor="#222222"
                        PlaceholderColor="#8792A2"
                        BackgroundColor="#F2F5F9" />

                </VerticalStackLayout>
            </Border>

            <!-- Preços dos combustíveis -->
            <Border
                BackgroundColor="White"
                Stroke="#E0E6ED"
                StrokeThickness="1"
                Padding="18"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Preços dos combustíveis"
                        FontSize="19"
                        FontAttributes="Bold"
                        TextColor="#17365D" />

                    <Label
                        Text="Gasolina (R$/litro)"
                        FontAttributes="Bold"
                        TextColor="#344054" />

                    <Entry
                        x:Name="GasolinaEntry"
                        Placeholder="Ex.: 6,00"
                        Keyboard="Numeric"
                        TextColor="#222222"
                        PlaceholderColor="#8792A2"
                        BackgroundColor="#F2F5F9" />

                    <Label
                        Text="Etanol (R$/litro)"
                        FontAttributes="Bold"
                        TextColor="#344054" />

                    <Entry
                        x:Name="EtanolEntry"
                        Placeholder="Ex.: 4,00"
                        Keyboard="Numeric"
                        TextColor="#222222"
                        PlaceholderColor="#8792A2"
                        BackgroundColor="#F2F5F9" />

                </VerticalStackLayout>
            </Border>

            <!-- Botão -->
            <Button
                Text="QUAL COMPENSA MAIS?"
                Clicked="OnCalcularClicked"
                BackgroundColor="#17365D"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="56"
                CornerRadius="14" />

            <!-- Resultado -->
            <Border
                BackgroundColor="#E7F5EC"
                Stroke="#B7E2C6"
                StrokeThickness="1"
                Padding="18"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Resultado da comparação"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#167347"
                        HorizontalTextAlignment="Center" />

                    <Label
                        x:Name="ResultadoLabel"
                        Text="Preencha os campos e toque no botão para calcular."
                        FontSize="16"
                        TextColor="#175C3B"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Informação -->
            <Label
                Text="Comparação baseada na regra de referência de 70%. O consumo real pode variar conforme o veículo."
                FontSize="12"
                TextColor="#667085"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
